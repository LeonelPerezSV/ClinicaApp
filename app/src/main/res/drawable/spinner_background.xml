<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Capa 1: El fondo con bordes redondeados (tu diseño original) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="@color/brandPrimary"/>
        </shape>
    </item>

    <!-- Capa 2: El ícono de la flecha hacia abajo (nuestro icono local y seguro) -->
    <item
        android:drawable="@drawable/ic_dropdown_arrow"
        android:gravity="end|center_vertical"
        android:end="12dp" />

</layer-list>
